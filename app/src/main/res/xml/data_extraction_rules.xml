<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The prefs hold the auth key and dashboard PIN: keep them off Google's backup and off device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
